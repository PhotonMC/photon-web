# Copy to .env.local for development; set these in Vercel for production.

# Launch moment — ISO 8601 WITH timezone offset. If unset or invalid the
# countdown shows "--".
NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T18:00:00+03:00

# Header links. A link is hidden when its URL is not set.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_DISCORD_URL=

# Canonical origin for Open Graph URLs. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Waitlist storage (Resend Contacts). Required in production; in development
# signups are logged to the console when RESEND_API_KEY is empty.
RESEND_API_KEY=
# Optional: add each signup to this Resend segment.
RESEND_SEGMENT_ID=
